{
  "name": "salescoach",
  "version": "0.2.1",
  "description": "Live AI sales coach overlay for Windows: listens to your calls and whispers short tips, invisible when you share your screen.",
  "main": "dist/main.js",
  "license": "MIT",
  "private": true,
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node scripts/build.mjs && electron .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node scripts/build.mjs --tests && node --test \"dist-tests/**/*.test.js\"",
    "eval": "node scripts/build.mjs --eval && node dist-eval/run-eval.js",
    "dist": "node scripts/build.mjs && electron-builder --win",
    "preview": "node scripts/preview-build.mjs",
    "shots": "node scripts/preview-build.mjs && electron scripts/shots.cjs",
    "smoke": "node scripts/build.mjs && node scripts/smoke.mjs"
  },
  "build": {
    "appId": "nl.reflowautomations.salescoach",
    "productName": "Salescoach",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    }
  },
  "dependencies": {
    "jose": "^6.2.12",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@types/node": "^26.6.4",
    "@types/ws": "^8.18.2",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
